---
import "@fontsource/geologica/700.css";
import "@fontsource/geologica/800.css";
import "@fontsource/onest/400.css";
import "@fontsource/onest/600.css";
import "../styles/tokens.css";
import "../styles/global.css";
import "../styles/site.css";
import displayFont from "@fontsource/geologica/files/geologica-cyrillic-800-normal.woff2?url";

interface Props { lang: string; title: string; description: string; canonical?: string; bodyRec?: string; }
const { lang, title, description, canonical, bodyRec } = Astro.props;
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <script is:inline>document.documentElement.classList.add("js")</script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content="uk_UA" />
    <meta name="theme-color" content="#FFFFFF" />
    <meta name="robots" content="noindex" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preload" href={displayFont} as="font" type="font/woff2" crossorigin />
    <slot name="head" />
  </head>
  <body data-rec={bodyRec}>
    <a class="skip-link" href="#main">{lang.startsWith("uk") ? "До змісту" : lang.startsWith("ru") ? "К содержанию" : "Skip to content"}</a>
    <slot name="header" />
    <main id="main"><slot /></main>
    <slot name="footer" />
    <script src="../scripts/reveal.ts"></script>
  </body>
</html>

<style is:global>
  /* Floor 4: horizontal overflow is clipped on both roots (also in global.css) */
  html { overflow-x: clip; }
  body { overflow-x: clip; }
</style>
